from transformers import pipeline

sentiment_model = pipeline(
    "sentiment-analysis",
    model="cardiffnlp/twitter-roberta-base-sentiment-latest",
    top_k=None,          # return probabilities for all 3 labels
    truncation=True,
    max_length=512
)

texts = df[column_name].astype(str).tolist()

results = sentiment_model(texts, batch_size=16)

labels, scores = [], []
for r in results:
    probs = {x["label"].lower(): x["score"] for x in r}
    labels.append(max(probs, key=probs.get).capitalize())          # Positive / Neutral / Negative
    scores.append(round(probs["positive"] - probs["negative"], 3))  # -1 to +1

df["Sentiment_Score"] = scores
df["Sentiment"] = labels

df[[column_name, "Sentiment_Score", "Sentiment"]].head(10)

print(df["Sentiment"].value_counts())

output_df = df[[column_name, "Sentiment_Score", "Sentiment"]]
output_df.to_excel(output_file, index=False)
print("Saved to", output_file)

