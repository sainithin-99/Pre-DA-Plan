from vaderSentiment.vaderSentiment import SentimentIntensityAnalyzer
import pandas as pd
import re

analyzer = SentimentIntensityAnalyzer()

# 1. Words that are neutral in feedback context (add yours as you spot them)
for w in ["issue", "issues", "problem", "problems", "delay", "delayed",
          "concern", "concerns", "complaint", "complaints", "error", "errors"]:
    analyzer.lexicon[w] = 0

# 2. Phrases VADER misreads: rewrite them before scoring
phrase_fixes = {
    r"\bno (issue|issues|problem|problems|complaint|complaints|concern|concerns)\b": "all good",
    r"\bnot bad\b": "good",
    r"\bnothing to complain\b": "all good",
    r"\bno (delay|delays)\b": "on time",
    r"\bresolved\b": "resolved well",
}

def clean_for_scoring(text):
    text = str(text).lower()
    for pattern, replacement in phrase_fixes.items():
        text = re.sub(pattern, replacement, text)
    return text

def get_sentiment(text):
    score = analyzer.polarity_scores(clean_for_scoring(text))["compound"]
    if score >= 0.25:
        label = "Positive"
    elif score <= -0.25:
        label = "Negative"
    else:
        label = "Neutral"
    return pd.Series([score, label])


